# ── .env.example ──────────────────────────────────────────────
# Copie para .env e preencha os valores reais.
# NUNCA commite o .env no git.

# Servidor
NODE_ENV=development
PORT=3000

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=briwax
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
# Alternativa (Heroku/Railway/Render): use DATABASE_URL
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Segurança JWT
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_STRING_ALEATORIA_LONGA_MINIMO_48_CHARS

# Bcrypt
BCRYPT_ROUNDS=12

# Upload de imagens
UPLOAD_MAX_SIZE_MB=10
