<%
/* ================================================================
   LOOP DINÂMICO — itera sectionsOrdered (ordem salva no banco)
   Cada seção é renderizada pelo seu section_key.
   Hero e footer são excluídos aqui (hero já renderizado acima,
   footer renderizado abaixo após o loop).
================================================================= */
var fp       = featuredProducts || [];
var fpFirst  = fp.length > 0 ? fp[0] : null;
var fpMiddle = fp.length > 2 ? fp.slice(1, fp.length - 1) : [];
var fpLast   = fp.length > 1 ? fp[fp.length - 1] : null;

var skippedKeys = ['hero', 'footer'];

sectionsOrdered.forEach(function(sec) {
  var key = sec.section_key;
  if(skippedKeys.indexOf(key) > -1) return; // hero e footer fora do loop
  if(sec.is_visible === false) return;       // seções ocultas não renderizam
%>

  <% if(key === 'feature_blue' && fpFirst){ %>
