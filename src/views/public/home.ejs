<script>
var bC=document.getElementById('beamCanvas'),bCtx=bC.getContext('2d'),bW,bH;
function resB(){bW=bC.width=bC.offsetWidth;bH=bC.height=bC.offsetHeight}resB();window.addEventListener('resize',resB);
var beams=[{x:.08,a:-.22,c:'rgba(59,130,246,',s:.004,p:0},{x:.92,a:.22,c:'rgba(35,82,232,',s:.005,p:1.3},{x:.3,a:-.1,c:'rgba(96,165,250,',s:.003,p:2.5},{x:.7,a:.1,c:'rgba(255,255,255,',s:.004,p:.9},{x:.5,a:0,c:'rgba(59,130,246,',s:.003,p:3.1}],bT=0;
(function drawB(){bCtx.clearRect(0,0,bW,bH);bT+=.016;beams.forEach(function(b){var a=b.a+Math.sin(bT*b.s*60+b.p)*.2;var ox=b.x*bW,oy=bH,len=bH*1.5,ex=ox+Math.sin(a)*len,ey=oy-Math.cos(a)*len,nx=-Math.sin(a),ny=-Math.cos(a);var g=bCtx.createLinearGradient(ox,oy,ex,ey);g.addColorStop(0,b.c+'0)');g.addColorStop(.1,b.c+'.3)');g.addColorStop(.5,b.c+'.1)');g.addColorStop(1,b.c+'0)');bCtx.beginPath();bCtx.moveTo(ox+nx*4,oy+ny*4);bCtx.lineTo(ex+nx*160,ey+ny*160);bCtx.lineTo(ex-nx*160,ey-ny*160);bCtx.lineTo(ox-nx*4,oy-ny*4);bCtx.closePath();bCtx.fillStyle=g;bCtx.fill();});requestAnimationFrame(drawB);})();
var burger=document.getElementById('burger'),nav=document.getElementById('navLinks');
burger.addEventListener('click',function(){nav.classList.toggle('open')});
nav.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){nav.classList.remove('open')})});
var io=new IntersectionObserver(function(e){e.forEach(function(v){if(v.isIntersecting)v.target.classList.add('visible')})},{threshold:.1});
document.querySelectorAll('.reveal,.reveal-l,.reveal-r').forEach(function(el){io.observe(el)});
</script>
