<%
/* admin/dashboard.ejs
   Vars: totalProducts, categories[], recentLogs[]
*/
%>
<%- include('../layouts/dashboard', { body: `

<!-- ── BOAS-VINDAS ───────────────────────────────────────────── -->
<div style="margin-bottom:2rem">
  <div style="font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.25em;color:var(--text-muted);margin-bottom:.3rem">
    // BEM-VINDO DE VOLTA
  </div>
  <h1 style="font-family:'Bebas Neue',sans-serif;font-size:2rem;letter-spacing:.08em;color:var(--text-dark)">
    Olá, ${user.name.split(' ')[0]}
  </h1>
  <p style="font-size:.85rem;color:var(--text-muted);margin-top:.2rem;letter-spacing:.04em">
    ${new Date().toLocaleDateString('pt-BR', { weekday:'long', day:'numeric', month:'long', year:'numeric' })}
  </p>
</div>

<!-- ── STATS ─────────────────────────────────────────────────── -->
<div class="stats-grid">
  <div class="stat-card accent">
    <div class="stat-label">Total de Produtos</div>
    <div class="stat-value">${totalProducts}</div>
    <div class="stat-sub">produtos no catálogo</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Categorias</div>
    <div class="stat-value">${categories.length}</div>
    <div class="stat-sub">segmentos ativos</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Nível de Acesso</div>
    <div class="stat-value" style="font-size:1.4rem;letter-spacing:.06em;padding-top:.3rem">
      <span class="badge ${user.role === 'admin' ? 'badge-admin' : 'badge-editor'}" style="font-size:.7rem">
        ${user.role === 'admin' ? '⬡ ADMIN' : '◈ EDITOR'}
      </span>
    </div>
    <div class="stat-sub">${user.role === 'admin' ? 'acesso total ao painel' : 'acesso a produtos e home'}</div>
  </div>
</div>

<!-- ── AÇÕES RÁPIDAS ─────────────────────────────────────────── -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin-bottom:2rem">

  <a href="/admin/produtos/novo" style="display:flex;align-items:center;gap:1rem;padding:1.2rem 1.4rem;background:var(--white);border:1px solid var(--border-blue);text-decoration:none;transition:all .2s;group" class="quick-card">
    <div style="width:40px;height:40px;background:rgba(35,82,232,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue-mid)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
    </div>
    <div>
      <div style="font-weight:700;font-size:.88rem;letter-spacing:.06em;color:var(--text-dark)">Novo Produto</div>
      <div style="font-size:.72rem;color:var(--text-muted);margin-top:1px">Adicionar ao catálogo</div>
    </div>
  </a>

  <a href="/admin/home-editor" style="display:flex;align-items:center;gap:1rem;padding:1.2rem 1.4rem;background:var(--white);border:1px solid var(--border-blue);text-decoration:none;transition:all .2s">
    <div style="width:40px;height:40px;background:rgba(35,82,232,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue-mid)" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    </div>
    <div>
      <div style="font-weight:700;font-size:.88rem;letter-spacing:.06em;color:var(--text-dark)">Editor da Home</div>
      <div style="font-size:.72rem;color:var(--text-muted);margin-top:1px">Editar seções e destaque</div>
    </div>
  </a>

  <a href="/admin/produtos" style="display:flex;align-items:center;gap:1rem;padding:1.2rem 1.4rem;background:var(--white);border:1px solid var(--border-blue);text-decoration:none;transition:all .2s">
    <div style="width:40px;height:40px;background:rgba(35,82,232,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue-mid)" stroke-width="2"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
    </div>
    <div>
      <div style="font-weight:700;font-size:.88rem;letter-spacing:.06em;color:var(--text-dark)">Ver Catálogo</div>
      <div style="font-size:.72rem;color:var(--text-muted);margin-top:1px">Gerenciar todos os produtos</div>
    </div>
  </a>

  ${user.role === 'admin' ? `
  <a href="/admin/marketing" style="display:flex;align-items:center;gap:1rem;padding:1.2rem 1.4rem;background:var(--white);border:1px solid var(--border-blue);text-decoration:none;transition:all .2s">
    <div style="width:40px;height:40px;background:rgba(35,82,232,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--blue-mid)" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
    </div>
    <div>
      <div style="font-weight:700;font-size:.88rem;letter-spacing:.06em;color:var(--text-dark)">Marketing</div>
      <div style="font-size:.72rem;color:var(--text-muted);margin-top:1px">Pixel e Analytics</div>
    </div>
  </a>
  ` : ''}
</div>

<!-- ── CATEGORIAS ─────────────────────────────────────────────── -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem">
  <div class="table-wrap">
    <div class="table-header">
      <div class="table-title">Categorias do Catálogo</div>
    </div>
    <table>
      <thead><tr><th>CATEGORIA</th><th>STATUS</th><th style="text-align:right">AÇÃO</th></tr></thead>
      <tbody>
        ${categories.map(c => `
          <tr>
            <td style="font-weight:700;font-size:.88rem">${c.name}</td>
            <td><span class="badge ${c.is_active ? 'badge-active' : 'badge-inactive'}">${c.is_active ? '● ATIVO' : '○ INATIVO'}</span></td>
            <td style="text-align:right">
              <a href="/catalogo/${c.slug}" target="_blank" class="btn-icon" title="Ver catálogo">
                <svg viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  </div>

  <!-- ── AUDIT LOG ── -->
  <div class="table-wrap">
    <div class="table-header">
      <div class="table-title">Atividade Recente</div>
    </div>
    ${recentLogs.length ? `
    <table>
      <thead><tr><th>AÇÃO</th><th>QUANDO</th></tr></thead>
      <tbody>
        ${recentLogs.map(l => `
          <tr>
            <td>
              <div style="font-family:'Share Tech Mono',monospace;font-size:.65rem;color:var(--blue-mid)">${l.action}</div>
              <div style="font-size:.72rem;color:var(--text-muted);margin-top:1px">${l.user_name || 'sistema'}</div>
            </td>
            <td style="font-family:'Share Tech Mono',monospace;font-size:.62rem;color:var(--text-muted);white-space:nowrap">
              ${new Date(l.created_at).toLocaleString('pt-BR', {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}
            </td>
          </tr>
        `).join('')}
      </tbody>
    </table>
    ` : `
    <div style="padding:2rem;text-align:center;color:var(--text-muted);font-size:.82rem">
      Nenhuma atividade registrada ainda.
    </div>
    `}
  </div>
</div>

<style>
a[href]:hover > div:first-child { background: rgba(35,82,232,.18) !important; }
</style>
` }) %>
