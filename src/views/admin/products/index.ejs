<%
/* admin/products/index.ejs
   Controller: productCtrl.list
   Vars: products[], categories[], total, page, totalPages, q, categoryId
*/
pageTitle  = 'Produtos';
currentPage = 'products';
breadcrumb = '// CATÁLOGO / PRODUTOS';
%>
<%- include('../../layouts/dashboard', { body: `

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:.75rem">
  <div>
    <div style="font-family:'Share Tech Mono',monospace;font-size:.62rem;letter-spacing:.22em;color:var(--text-muted)">${total} produto(s) encontrado(s)</div>
  </div>
  <a href="/admin/produtos/novo" class="btn btn-primary">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
    Novo Produto
  </a>
</div>

<div class="table-wrap">
  <div class="table-header">
    <div class="table-title">Todos os Produtos</div>
    <form method="GET" action="/admin/produtos" style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
      <div class="table-search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" name="q" value="${q || ''}" placeholder="Buscar por nome ou SKU..."/>
      </div>
      <select name="categoria" onchange="this.form.submit()" style="font-family:'Rajdhani',sans-serif;font-size:.82rem;padding:.5rem .8rem;border:1.5px solid var(--border-blue);background:var(--off-white);color:var(--text-dark);cursor:pointer">
        <option value="">Todas as Categorias</option>
        ${categories.map(c => `<option value="${c.id}" ${categoryId == c.id ? 'selected' : ''}>${c.name}</option>`).join('')}
      </select>
      <button type="submit" class="btn btn-outline">Filtrar</button>
    </form>
  </div>

  <div style="overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>PRODUTO</th>
          <th>SKU</th>
          <th>CATEGORIA</th>
          <th>STATUS</th>
          <th>ATUALIZADO</th>
          <th style="text-align:right">AÇÕES</th>
        </tr>
      </thead>
      <tbody>
        ${products.length === 0 ? `
          <tr><td colspan="6" style="text-align:center;padding:3rem;color:var(--text-muted);font-size:.88rem;letter-spacing:.06em">
            Nenhum produto encontrado.
          </td></tr>
        ` : products.map(p => `
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:.75rem">
                ${p.cover_image
                  ? `<img src="${p.cover_image}" alt="${p.name}" style="width:40px;height:40px;object-fit:cover;border:1px solid var(--border-blue);flex-shrink:0">`
                  : `<div style="width:40px;height:40px;background:var(--gray);border:1px solid var(--border-blue);flex-shrink:0;display:flex;align-items:center;justify-content:center"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>`
                }
                <div>
                  <div style="font-weight:700;font-size:.88rem;letter-spacing:.04em">${p.name}</div>
                  ${p.short_desc ? `<div style="font-size:.75rem;color:var(--text-muted);margin-top:1px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${p.short_desc}</div>` : ''}
                </div>
              </div>
            </td>
            <td><span class="td-sku">${p.sku}</span></td>
            <td style="font-size:.82rem;color:var(--text-muted)">${p.category_name || '—'}</td>
            <td>
              <span class="badge ${p.is_active ? 'badge-active' : 'badge-inactive'}">
                ${p.is_active ? '● ATIVO' : '○ INATIVO'}
              </span>
            </td>
            <td style="font-family:'Share Tech Mono',monospace;font-size:.65rem;color:var(--text-muted)">
              ${new Date(p.updated_at).toLocaleDateString('pt-BR')}
            </td>
            <td>
              <div class="td-actions">
                <a href="/produto/${p.slug}" target="_blank" class="btn-icon" title="Ver no site">
                  <svg viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
                <a href="/admin/produtos/${p.id}/editar" class="btn-icon" title="Editar">
                  <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </a>
                <form action="/admin/produtos/${p.id}/excluir" method="POST"
                      onsubmit="return confirm('Excluir \\'${p.name}\\' permanentemente?')">
                  <button type="submit" class="btn-icon danger" title="Excluir">
                    <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a1 1 0 011-1h4a1 1 0 011 1v2"/></svg>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  </div>

  ${totalPages > 1 ? `
  <div style="padding:1rem 1.5rem;border-top:1px solid var(--border-blue)">
    <div class="pagination">
      ${page > 1 ? `<a href="?q=${q||''}&categoria=${categoryId||''}&page=${page-1}" class="page-btn">← ANTERIOR</a>` : ''}
      ${Array.from({length: totalPages}, (_,i) => i+1).map(n =>
        `<a href="?q=${q||''}&categoria=${categoryId||''}&page=${n}" class="page-btn ${n==page?'active':''}">${n}</a>`
      ).join('')}
      ${page < totalPages ? `<a href="?q=${q||''}&categoria=${categoryId||''}&page=${parseInt(page)+1}" class="page-btn">PRÓXIMA →</a>` : ''}
    </div>
  </div>
  ` : ''}
</div>
` }) %>
