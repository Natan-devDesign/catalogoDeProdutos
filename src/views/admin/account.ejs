<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title><%= pageTitle %> &middot; BRIWAX Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue-deep:#071470;--blue-mid:#1135b8;--blue-bright:#2352e8;--white:#fff;--off-white:#f0f5ff;--gray:#e8eef8;--text-dark:#0d1a5c;--text-muted:#5a6fa8;--border-blue:rgba(35,82,232,.15);--success:#16a34a;--danger:#dc2626;--sidebar-w:260px;--topbar-h:60px}
html,body{height:100%}body{font-family:'Rajdhani',sans-serif;background:var(--off-white);color:var(--text-dark);display:flex;overflow-x:hidden}
.sidebar{width:var(--sidebar-w);min-height:100vh;background:var(--blue-deep);display:flex;flex-direction:column;position:fixed;top:0;left:0;z-index:200}
.sidebar-logo{font-family:'Bebas Neue',sans-serif;font-size:1.65rem;letter-spacing:.2em;color:var(--white);padding:1.4rem 1.5rem 1rem;border-bottom:1px solid rgba(255,255,255,.08);text-decoration:none;display:block}
.sidebar-section{padding:.8rem 1.5rem .3rem;font-family:'Share Tech Mono',monospace;font-size:.55rem;letter-spacing:.28em;color:rgba(255,255,255,.25);text-transform:uppercase}
.sidebar-nav{flex:1;padding:.5rem 0;overflow-y:auto}
.nav-item{display:flex;align-items:center;gap:.75rem;padding:.78rem 1.5rem;font-weight:600;font-size:.76rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.6);text-decoration:none;border-left:3px solid transparent;transition:all .2s}
.nav-item svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.8;flex-shrink:0}
.nav-item:hover{color:rgba(255,255,255,.9);background:rgba(255,255,255,.05);border-left-color:rgba(255,255,255,.2)}
.nav-item.active{color:var(--white);background:rgba(35,82,232,.25);border-left-color:var(--blue-bright)}
.sidebar-user{padding:1rem 1.5rem;border-top:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:.75rem}
.user-avatar{width:34px;height:34px;border-radius:50%;background:var(--blue-bright);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:1rem;color:var(--white);flex-shrink:0}
.user-info{flex:1;min-width:0}.user-name{font-weight:700;font-size:.8rem;letter-spacing:.06em;color:var(--white);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.user-role{font-size:.65rem;color:rgba(255,255,255,.4);letter-spacing:.1em;text-transform:uppercase}
.logout-btn{color:rgba(255,255,255,.4);background:none;border:none;cursor:pointer;padding:4px;transition:color .2s}.logout-btn:hover{color:rgba(255,255,255,.9)}.logout-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8}
.main-wrap{margin-left:var(--sidebar-w);flex:1;min-height:100vh;display:flex;flex-direction:column}
.topbar{height:var(--topbar-h);background:var(--white);border-bottom:1px solid var(--border-blue);display:flex;align-items:center;justify-content:space-between;padding:0 2rem;position:sticky;top:0;z-index:100;box-shadow:0 1px 12px rgba(7,20,112,.06)}
.page-title{font-family:'Bebas Neue',sans-serif;font-size:1.3rem;letter-spacing:.1em;color:var(--text-dark)}.page-breadcrumb{font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.18em;color:var(--text-muted)}
.site-link{color:var(--text-muted);font-size:.72rem;font-weight:600;letter-spacing:.1em;text-decoration:none;display:flex;align-items:center;gap:.3rem;transition:color .2s}.site-link:hover{color:var(--blue-mid)}.site-link svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2}
.page-content{flex:1;padding:2rem 2.5rem 3rem;max-width:720px}
.flash{padding:.85rem 1.2rem;margin-bottom:1.5rem;font-weight:600;font-size:.85rem;letter-spacing:.06em;border-left:3px solid;display:flex;align-items:center;gap:.6rem}.flash svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;flex-shrink:0}.flash-success{background:rgba(22,163,74,.08);border-color:var(--success);color:var(--success)}.flash-error{background:rgba(220,38,38,.08);border-color:var(--danger);color:var(--danger)}
/* PROFILE CARD */
.profile-card{background:var(--white);border:1px solid var(--border-blue);padding:1.8rem 2rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:1.5rem}
.profile-avatar{width:64px;height:64px;border-radius:50%;background:var(--blue-mid);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:2rem;color:var(--white);flex-shrink:0}
.profile-info{flex:1}
.profile-name{font-family:'Bebas Neue',sans-serif;font-size:1.6rem;letter-spacing:.06em;color:var(--text-dark);line-height:1}
.profile-email{font-family:'Share Tech Mono',monospace;font-size:.7rem;letter-spacing:.14em;color:var(--text-muted);margin-top:.3rem}
.profile-role{display:inline-block;margin-top:.5rem;font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.14em;padding:3px 10px}
.role-admin{background:rgba(35,82,232,.1);color:var(--blue-mid)}
.role-editor{background:rgba(217,119,6,.1);color:#d97706}
/* FORM */
.form-section{background:var(--white);border:1px solid var(--border-blue);padding:1.6rem 2rem;margin-bottom:1.2rem}
.form-section-title{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;letter-spacing:.08em;color:var(--text-dark);margin-bottom:.4rem}
.form-section-sub{font-size:.8rem;color:var(--text-muted);letter-spacing:.04em;margin-bottom:1.4rem;padding-bottom:1rem;border-bottom:1px solid var(--border-blue)}
.form-group{display:flex;flex-direction:column;gap:.4rem;margin-bottom:1.1rem}
.form-group:last-of-type{margin-bottom:0}
label{font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.2em;color:var(--text-muted);text-transform:uppercase}
label .req{color:var(--blue-bright)}
.input-wrap{position:relative}
input[type=password]{font-family:'Rajdhani',sans-serif;font-size:.95rem;font-weight:500;letter-spacing:.04em;background:var(--off-white);border:1.5px solid var(--border-blue);color:var(--text-dark);padding:.72rem 2.8rem .72rem .9rem;outline:none;transition:border-color .25s,box-shadow .25s;width:100%;clip-path:polygon(5px 0%,100% 0%,100% calc(100% - 5px),calc(100% - 5px) 100%,0% 100%,0% 5px)}
input[type=password]:focus{border-color:var(--blue-bright);box-shadow:0 0 0 3px rgba(35,82,232,.1)}
.toggle-vis{position:absolute;right:.75rem;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-muted);padding:2px;transition:color .2s;display:flex;align-items:center}
.toggle-vis:hover{color:var(--blue-mid)}.toggle-vis svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2}
.strength-bar{height:4px;background:var(--gray);margin-top:.4rem;position:relative;overflow:hidden}
.strength-fill{height:100%;width:0;transition:width .3s,background .3s}
.strength-label{font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.14em;color:var(--text-muted);margin-top:.3rem}
.form-hint{font-size:.72rem;color:var(--text-muted);letter-spacing:.04em;margin-top:.2rem}
.form-actions{display:flex;align-items:center;justify-content:space-between;padding-top:1.2rem;margin-top:1rem;border-top:1px solid var(--border-blue);flex-wrap:wrap;gap:.75rem}
.btn{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;padding:.55rem 1.4rem;cursor:pointer;transition:all .22s;display:inline-flex;align-items:center;gap:.4rem;text-decoration:none;border:1.5px solid;clip-path:polygon(5px 0%,100% 0%,100% calc(100% - 5px),calc(100% - 5px) 100%,0% 100%,0% 5px)}
.btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}
.btn-primary{background:var(--blue-mid);border-color:var(--blue-mid);color:var(--white)}.btn-primary:hover{background:var(--blue-bright);border-color:var(--blue-bright)}
.btn-outline{background:transparent;border-color:var(--border-blue);color:var(--text-muted)}.btn-outline:hover{border-color:var(--blue-bright);color:var(--blue-bright)}
/* REQUIREMENTS */
.req-list{display:grid;grid-template-columns:1fr 1fr;gap:.3rem .8rem;margin-top:.6rem}
.req-item{font-size:.72rem;letter-spacing:.04em;color:var(--text-muted);display:flex;align-items:center;gap:.35rem;transition:color .2s}
.req-item svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.5;flex-shrink:0}
.req-item.ok{color:var(--success)}.req-item.fail{color:var(--danger)}
/* INFO BOX (admin alterando outro user) */
.info-box{background:rgba(217,119,6,.07);border:1px solid rgba(217,119,6,.25);padding:.9rem 1.1rem;margin-bottom:1.4rem;font-size:.82rem;color:#92400e;letter-spacing:.04em;line-height:1.6}
.info-box svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;vertical-align:middle;margin-right:.3rem}
@media(max-width:900px){.main-wrap{margin-left:0}.page-content{padding:1.2rem 1rem 2rem;max-width:100%}}
</style>
</head>
<body>

<aside class="sidebar">
  <a href="/admin" class="sidebar-logo">BRIWAX</a>
  <nav class="sidebar-nav">
    <div class="sidebar-section">Principal</div>
    <a href="/admin" class="nav-item"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>Dashboard</a>
    <div class="sidebar-section">Catalogo</div>
    <a href="/admin/produtos" class="nav-item"><svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>Produtos</a>
    <a href="/admin/produtos/novo" class="nav-item"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>Adicionar Produto</a>
    <div class="sidebar-section">Site</div>
    <a href="/admin/home-editor" class="nav-item"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>Editor da Home</a>
    <% if(user.role === 'admin'){ %>
    <div class="sidebar-section">Marketing</div>
    <a href="/admin/marketing" class="nav-item"><svg viewBox="0 0 24 24"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>Marketing &amp; Analytics</a>
    <a href="/admin/usuarios" class="nav-item <%= currentPage === 'users' ? 'active' : '' %>"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>Usuarios</a>
    <% } %>
    <div class="sidebar-section">Conta</div>
    <a href="/admin/minha-conta" class="nav-item <%= currentPage === 'account' ? 'active' : '' %>"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Minha Conta</a>
  </nav>
  <div class="sidebar-user">
    <div class="user-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
    <div class="user-info"><div class="user-name"><%= user.name %></div><div class="user-role"><%= user.role %></div></div>
    <form action="/auth/logout" method="POST" style="margin:0"><button type="submit" class="logout-btn" title="Sair"><svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></button></form>
  </div>
</aside>

<div class="main-wrap">
  <header class="topbar">
    <div><div class="page-title"><%= pageTitle %></div><div class="page-breadcrumb"><%= breadcrumb %></div></div>
    <a href="/" target="_blank" class="site-link"><svg viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>Ver Site</a>
  </header>
  <main class="page-content">

    <% if(flash){ %>
    <div class="flash flash-<%= flash.type %>">
      <svg viewBox="0 0 24 24"><% if(flash.type === 'success'){ %><polyline points="20 6 9 17 4 12"/><% } else { %><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/><% } %></svg>
      <%= flash.message %>
    </div>
    <% } %>

    <%
      // targetUser definido = admin alterando outro usuário
      // targetUser null = usuário alterando a própria conta
      var isAdminChangingOther = (targetUser !== null);
      var displayUser = isAdminChangingOther ? targetUser : user;
      var formAction  = isAdminChangingOther
        ? '/admin/usuarios/' + targetUser.id + '/senha'
        : '/admin/minha-conta';
    %>

    <!-- CARD DO PERFIL -->
    <div class="profile-card">
      <div class="profile-avatar"><%= displayUser.name.charAt(0).toUpperCase() %></div>
      <div class="profile-info">
        <div class="profile-name"><%= displayUser.name %></div>
        <div class="profile-email"><%= displayUser.email %></div>
        <span class="profile-role <%= displayUser.role === 'admin' ? 'role-admin' : 'role-editor' %>">
          <%= displayUser.role === 'admin' ? '&#9655; ADMIN' : '&#9671; EDITOR' %>
        </span>
      </div>
      <% if(isAdminChangingOther){ %>
      <a href="/admin/usuarios" class="btn btn-outline">
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        Voltar
      </a>
      <% } %>
    </div>

    <!-- AVISO QUANDO ADMIN ALTERA OUTRO USUÁRIO -->
    <% if(isAdminChangingOther){ %>
    <div class="info-box">
      <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      Voce esta alterando a senha de <strong><%= targetUser.name %></strong>. O usuario devera usar a nova senha no proximo login.
    </div>
    <% } %>

    <!-- FORMULARIO DE SENHA -->
    <div class="form-section">
      <div class="form-section-title">
        <% if(isAdminChangingOther){ %>Definir Nova Senha<% } else { %>Alterar Minha Senha<% } %>
      </div>
      <div class="form-section-sub">
        <% if(isAdminChangingOther){ %>
        Define uma nova senha para o usuario. Nao e necessario informar a senha atual.
        <% } else { %>
        Para alterar sua senha, confirme a senha atual e escolha uma nova senha forte.
        <% } %>
      </div>

      <form action="<%= formAction %>" method="POST" id="pwdForm" autocomplete="off">

        <!-- SENHA ATUAL — apenas para o proprio usuario -->
        <% if(!isAdminChangingOther){ %>
        <div class="form-group">
          <label>Senha Atual <span class="req">*</span></label>
          <div class="input-wrap">
            <input type="password" name="current_password" id="currentPwd"
                   placeholder="Sua senha atual" autocomplete="current-password" required/>
            <button type="button" class="toggle-vis" onclick="toggleVis('currentPwd', this)">
              <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <% } %>

        <!-- NOVA SENHA -->
        <div class="form-group">
          <label>Nova Senha <span class="req">*</span></label>
          <div class="input-wrap">
            <input type="password" name="new_password" id="newPwd"
                   placeholder="Minimo 8 caracteres"
                   autocomplete="new-password" required
                   oninput="checkStrength(this.value); checkMatch()"/>
            <button type="button" class="toggle-vis" onclick="toggleVis('newPwd', this)">
              <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
          <div class="strength-label" id="strengthLabel">Digite a nova senha</div>
          <!-- Requisitos visuais -->
          <div class="req-list">
            <div class="req-item" id="req-len">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/></svg>
              Minimo 8 caracteres
            </div>
            <div class="req-item" id="req-upper">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/></svg>
              Letra maiuscula
            </div>
            <div class="req-item" id="req-num">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/></svg>
              Numero
            </div>
            <div class="req-item" id="req-special">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/></svg>
              Caractere especial
            </div>
          </div>
        </div>

        <!-- CONFIRMAR SENHA -->
        <div class="form-group">
          <label>Confirmar Nova Senha <span class="req">*</span></label>
          <div class="input-wrap">
            <input type="password" name="confirm_password" id="confirmPwd"
                   placeholder="Repita a nova senha"
                   autocomplete="new-password" required
                   oninput="checkMatch()"/>
            <button type="button" class="toggle-vis" onclick="toggleVis('confirmPwd', this)">
              <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <div class="form-hint" id="matchHint">&nbsp;</div>
        </div>

        <div class="form-actions">
          <a href="/admin" class="btn btn-outline">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
            Cancelar
          </a>
          <button type="submit" class="btn btn-primary" id="submitBtn">
            <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            <% if(isAdminChangingOther){ %>Definir Nova Senha<% } else { %>Alterar Senha<% } %>
          </button>
        </div>
      </form>
    </div>

    <!-- LISTA DE USUARIOS (admin vendo sua propria conta) -->
    <% if(!isAdminChangingOther && user.role === 'admin'){ %>
    <div class="form-section">
      <div class="form-section-title">Gerenciar Senhas de Outros Usuarios</div>
      <div class="form-section-sub">Como administrador, voce pode redefinir a senha de qualquer usuario.</div>
      <p style="font-size:.85rem;color:var(--text-muted)">
        Acesse a pagina de <a href="/admin/usuarios" style="color:var(--blue-mid);font-weight:700;text-decoration:none">Usuarios</a>
        e clique em <strong>Alterar Senha</strong> ao lado do usuario desejado.
      </p>
    </div>
    <% } %>

  </main>
</div>

<script>
/* MOSTRAR/OCULTAR SENHA */
function toggleVis(inputId, btn) {
  var inp = document.getElementById(inputId);
  var isText = inp.type === 'text';
  inp.type = isText ? 'password' : 'text';
  btn.querySelector('svg').innerHTML = isText
    ? '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>'
    : '<path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
}

/* FORÇA DA SENHA */
function checkStrength(val) {
  var len     = val.length >= 8;
  var upper   = /[A-Z]/.test(val);
  var num     = /[0-9]/.test(val);
  var special = /[^A-Za-z0-9]/.test(val);
  var score   = [len, upper, num, special].filter(Boolean).length;

  var fill  = document.getElementById('strengthFill');
  var label = document.getElementById('strengthLabel');
  var colors = ['','#dc2626','#d97706','#3b82f6','#16a34a'];
  var labels = ['','Fraca','Razoavel','Boa','Forte'];

  fill.style.width     = (score * 25) + '%';
  fill.style.background = colors[score] || '#e8eef8';
  label.textContent    = val.length ? labels[score] : 'Digite a nova senha';
  label.style.color    = colors[score] || 'var(--text-muted)';

  setReq('req-len',     len);
  setReq('req-upper',   upper);
  setReq('req-num',     num);
  setReq('req-special', special);
}

function setReq(id, ok) {
  var el  = document.getElementById(id);
  var svg = '<circle cx="12" cy="12" r="10"/>';
  el.className = 'req-item ' + (ok ? 'ok' : '');
  el.querySelector('svg').innerHTML = ok
    ? '<polyline points="20 6 9 17 4 12"/>'
    : svg + '<line x1="12" y1="8" x2="12" y2="16"/>';
}

/* CONFIRMAR SENHA */
function checkMatch() {
  var np   = document.getElementById('newPwd').value;
  var cp   = document.getElementById('confirmPwd').value;
  var hint = document.getElementById('matchHint');
  var btn  = document.getElementById('submitBtn');
  if (!cp) { hint.textContent = '\u00a0'; hint.style.color = ''; return; }
  if (np === cp) {
    hint.textContent = '✓ Senhas coincidem';
    hint.style.color = '#16a34a';
    btn.disabled = false;
  } else {
    hint.textContent = '✗ Senhas nao coincidem';
    hint.style.color = '#dc2626';
    btn.disabled = true;
  }
}

/* PREVENIR SUBMIT SE SENHAS NAO COINCIDEM */
document.getElementById('pwdForm').addEventListener('submit', function(e) {
  var np = document.getElementById('newPwd').value;
  var cp = document.getElementById('confirmPwd').value;
  if (np !== cp) { e.preventDefault(); alert('As senhas nao coincidem.'); }
  if (np.length < 8) { e.preventDefault(); alert('A senha deve ter no minimo 8 caracteres.'); }
});
</script>
</body>
</html>
