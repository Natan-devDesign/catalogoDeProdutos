<%
pageTitle   = 'Marketing & Analytics';
currentPage = 'marketing';
breadcrumb  = '// CONFIG / MARKETING';

var fbConfig  = null;
var gtmConfig = null;
var ga4Config = null;
configs.forEach(function(c){
  if(c.provider === 'facebook_pixel') fbConfig  = c;
  if(c.provider === 'gtm')            gtmConfig = c;
  if(c.provider === 'ga4')            ga4Config = c;
});
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title><%= pageTitle %> &middot; BRIWAX Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue-deep:#071470;--blue-mid:#1135b8;--blue-bright:#2352e8;--white:#fff;--off-white:#f0f5ff;--gray:#e8eef8;--text-dark:#0d1a5c;--text-muted:#5a6fa8;--border-blue:rgba(35,82,232,.15);--success:#16a34a;--danger:#dc2626;--warning:#d97706;--sidebar-w:260px;--topbar-h:60px}
html,body{height:100%}body{font-family:'Rajdhani',sans-serif;background:var(--off-white);color:var(--text-dark);display:flex;overflow-x:hidden}
.sidebar{width:var(--sidebar-w);min-height:100vh;background:var(--blue-deep);display:flex;flex-direction:column;position:fixed;top:0;left:0;z-index:200}
.sidebar-logo{font-family:'Bebas Neue',sans-serif;font-size:1.65rem;letter-spacing:.2em;color:var(--white);padding:1.4rem 1.5rem 1rem;border-bottom:1px solid rgba(255,255,255,.08);text-decoration:none;display:block}
.sidebar-section{padding:.8rem 1.5rem .3rem;font-family:'Share Tech Mono',monospace;font-size:.55rem;letter-spacing:.28em;color:rgba(255,255,255,.25);text-transform:uppercase}
.sidebar-nav{flex:1;padding:.5rem 0;overflow-y:auto}
.nav-item{display:flex;align-items:center;gap:.75rem;padding:.78rem 1.5rem;font-weight:600;font-size:.76rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.6);text-decoration:none;border-left:3px solid transparent;transition:all .2s}
.nav-item svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.8;flex-shrink:0}
.nav-item:hover{color:rgba(255,255,255,.9);background:rgba(255,255,255,.05);border-left-color:rgba(255,255,255,.2)}
.nav-item.active{color:var(--white);background:rgba(35,82,232,.25);border-left-color:var(--blue-bright)}
.sidebar-user{padding:1rem 1.5rem;border-top:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:.75rem}
.user-avatar{width:34px;height:34px;border-radius:50%;background:var(--blue-bright);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:1rem;color:var(--white);flex-shrink:0}
.user-info{flex:1;min-width:0}.user-name{font-weight:700;font-size:.8rem;letter-spacing:.06em;color:var(--white);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.user-role{font-size:.65rem;color:rgba(255,255,255,.4);letter-spacing:.1em;text-transform:uppercase}
.logout-btn{color:rgba(255,255,255,.4);background:none;border:none;cursor:pointer;padding:4px;transition:color .2s}.logout-btn:hover{color:rgba(255,255,255,.9)}.logout-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8}
.main-wrap{margin-left:var(--sidebar-w);flex:1;min-height:100vh;display:flex;flex-direction:column}
.topbar{height:var(--topbar-h);background:var(--white);border-bottom:1px solid var(--border-blue);display:flex;align-items:center;justify-content:space-between;padding:0 2rem;position:sticky;top:0;z-index:100;box-shadow:0 1px 12px rgba(7,20,112,.06)}
.page-title{font-family:'Bebas Neue',sans-serif;font-size:1.3rem;letter-spacing:.1em;color:var(--text-dark)}.page-breadcrumb{font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.18em;color:var(--text-muted)}
.site-link{color:var(--text-muted);font-size:.72rem;font-weight:600;letter-spacing:.1em;text-decoration:none;display:flex;align-items:center;gap:.3rem;transition:color .2s}.site-link:hover{color:var(--blue-mid)}.site-link svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2}
.page-content{flex:1;padding:2rem 2.5rem 3rem}
.flash{padding:.85rem 1.2rem;margin-bottom:1.5rem;font-weight:600;font-size:.85rem;letter-spacing:.06em;border-left:3px solid;display:flex;align-items:center;gap:.6rem}.flash svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;flex-shrink:0}.flash-success{background:rgba(22,163,74,.08);border-color:var(--success);color:var(--success)}.flash-error{background:rgba(220,38,38,.08);border-color:var(--danger);color:var(--danger)}
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:2rem}
.stat-card{background:var(--white);border:1px solid var(--border-blue);padding:1.4rem 1.5rem;display:flex;flex-direction:column;gap:.4rem;clip-path:polygon(8px 0%,100% 0%,100% calc(100% - 8px),calc(100% - 8px) 100%,0% 100%,0% 8px)}.stat-card.accent{border-color:var(--blue-mid);border-left:3px solid var(--blue-mid)}
.stat-label{font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.22em;color:var(--text-muted);text-transform:uppercase}.stat-value{font-size:1rem;padding-top:.3rem;word-break:break-all}.stat-card.accent .stat-value{color:var(--blue-mid)}
.badge{font-family:'Share Tech Mono',monospace;font-size:.58rem;letter-spacing:.15em;padding:3px 9px;display:inline-flex;align-items:center;gap:4px}.badge-active{background:rgba(22,163,74,.1);color:var(--success)}.badge-inactive{background:rgba(107,114,128,.1);color:var(--text-muted)}
.form-section{padding:1.4rem 1.5rem;background:var(--white);border:1px solid var(--border-blue);margin-bottom:1.2rem}
.form-section-title{font-family:'Bebas Neue',sans-serif;font-size:1rem;letter-spacing:.1em;color:var(--text-dark);margin-bottom:1rem;padding-bottom:.6rem;border-bottom:1px solid var(--border-blue);display:flex;align-items:center;justify-content:space-between}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
.form-group{display:flex;flex-direction:column;gap:.4rem}
label{font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.2em;color:var(--text-muted);text-transform:uppercase}
input[type=text]{font-family:'Rajdhani',sans-serif;font-size:.92rem;font-weight:500;letter-spacing:.04em;background:var(--off-white);border:1.5px solid var(--border-blue);color:var(--text-dark);padding:.65rem .9rem;outline:none;transition:border-color .25s;width:100%;clip-path:polygon(5px 0%,100% 0%,100% calc(100% - 5px),calc(100% - 5px) 100%,0% 100%,0% 5px)}
input[type=text]:focus{border-color:var(--blue-bright)}
.form-hint{font-size:.72rem;color:var(--text-muted);letter-spacing:.04em}
.form-actions{display:flex;align-items:center;justify-content:flex-end;padding-top:.75rem;margin-top:.5rem}
.toggle-wrap{display:flex;align-items:center;gap:.75rem;margin-top:.3rem}
.toggle{position:relative;width:42px;height:24px;flex-shrink:0}
.toggle input{opacity:0;width:0;height:0;position:absolute}
.toggle-track{position:absolute;inset:0;border-radius:12px;background:var(--gray);transition:background .25s;cursor:pointer;display:block}
.toggle input:checked + .toggle-track{background:var(--blue-mid)}
.toggle-track::after{content:'';position:absolute;left:3px;top:3px;width:18px;height:18px;border-radius:50%;background:var(--white);transition:transform .25s;box-shadow:0 1px 4px rgba(0,0,0,.2)}
.toggle input:checked + .toggle-track::after{transform:translateX(18px)}
.toggle-label{font-weight:600;font-size:.82rem;color:var(--text-dark)}
.btn{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;padding:.5rem 1.3rem;cursor:pointer;transition:all .22s;display:inline-flex;align-items:center;gap:.4rem;text-decoration:none;border:1.5px solid;clip-path:polygon(5px 0%,100% 0%,100% calc(100% - 5px),calc(100% - 5px) 100%,0% 100%,0% 5px)}.btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}.btn-primary{background:var(--blue-mid);border-color:var(--blue-mid);color:var(--white)}.btn-primary:hover{background:var(--blue-bright);border-color:var(--blue-bright)}
.code-block{margin-top:1rem;padding:1rem;background:#071470;border:1px solid rgba(255,255,255,.1);overflow-x:auto}
.code-label{font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.18em;color:rgba(255,255,255,.4);margin-bottom:.5rem}
.code-text{font-family:'Share Tech Mono',monospace;font-size:.68rem;color:rgba(255,255,255,.7);line-height:1.6;white-space:pre-wrap;word-break:break-all}
.code-hl{color:#60a5fa}
.table-wrap{background:var(--white);border:1px solid var(--border-blue);overflow:hidden;margin-top:1.2rem}
.table-header{padding:1.1rem 1.5rem;border-bottom:1px solid var(--border-blue)}.table-title{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;letter-spacing:.08em;color:var(--text-dark)}
table{width:100%;border-collapse:collapse}thead{background:var(--off-white);border-bottom:1px solid var(--border-blue)}thead th{font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.2em;color:var(--text-muted);padding:.8rem 1.2rem;text-align:left;white-space:nowrap}tbody tr{border-bottom:1px solid rgba(35,82,232,.07)}tbody tr:last-child{border-bottom:none}tbody td{padding:.85rem 1.2rem;font-size:.88rem;color:var(--text-dark);vertical-align:middle}
@media(max-width:900px){.main-wrap{margin-left:0}.page-content{padding:1.2rem 1rem 2rem}.form-grid{grid-template-columns:1fr}}
</style>
</head>
<body>

<aside class="sidebar">
  <a href="/admin" class="sidebar-logo">BRIWAX</a>
  <nav class="sidebar-nav">
    <div class="sidebar-section">Principal</div>
    <a href="/admin" class="nav-item"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>Dashboard</a>
    <div class="sidebar-section">Catalogo</div>
    <a href="/admin/produtos" class="nav-item"><svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>Produtos</a>
    <a href="/admin/produtos/novo" class="nav-item"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>Adicionar Produto</a>
    <div class="sidebar-section">Site</div>
    <a href="/admin/home-editor" class="nav-item"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>Editor da Home</a>
    <div class="sidebar-section">Marketing</div>
    <a href="/admin/marketing" class="nav-item active"><svg viewBox="0 0 24 24"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>Marketing &amp; Analytics</a>
    <% if(user.role === 'admin'){ %>
    <a href="/admin/usuarios" class="nav-item"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>Usuarios</a>
    <% } %>
  </nav>
  <div class="sidebar-user">
    <div class="user-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
    <div class="user-info">
      <div class="user-name"><%= user.name %></div>
      <div class="user-role"><%= user.role %></div>
    </div>
    <form action="/auth/logout" method="POST" style="margin:0">
      <button type="submit" class="logout-btn" title="Sair"><svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></button>
    </form>
  </div>
</aside>

<div class="main-wrap">
  <header class="topbar">
    <div><div class="page-title"><%= pageTitle %></div><div class="page-breadcrumb"><%= breadcrumb %></div></div>
    <a href="/" target="_blank" class="site-link"><svg viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>Ver Site</a>
  </header>
  <main class="page-content">

    <% if(flash){ %>
    <div class="flash flash-<%= flash.type %>">
      <svg viewBox="0 0 24 24"><% if(flash.type === 'success'){ %><polyline points="20 6 9 17 4 12"/><% } else { %><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/><% } %></svg>
      <%= flash.message %>
    </div>
    <% } %>

    <div class="stats-grid">
      <% configs.forEach(function(c){ %>
      <div class="stat-card <%= (c.is_active && c.tracking_id) ? 'accent' : '' %>">
        <div class="stat-label"><%= c.label %></div>
        <div class="stat-value" style="font-family:'Share Tech Mono',monospace">
          <% if(c.tracking_id){ %><%= c.tracking_id %><% } else { %><span style="color:var(--text-muted);font-family:'Rajdhani',sans-serif">Nao configurado</span><% } %>
        </div>
        <div><span class="badge <%= (c.is_active && c.tracking_id) ? 'badge-active' : 'badge-inactive' %>"><%= (c.is_active && c.tracking_id) ? 'ATIVO' : 'INATIVO' %></span></div>
      </div>
      <% }); %>
    </div>

    <!-- FB PIXEL -->
    <div class="form-section">
      <div class="form-section-title">
        <span>Facebook Pixel</span>
        <span class="badge <%= (fbConfig && fbConfig.is_active && fbConfig.tracking_id) ? 'badge-active' : 'badge-inactive' %>"><%= (fbConfig && fbConfig.is_active && fbConfig.tracking_id) ? 'ATIVO' : 'INATIVO' %></span>
      </div>
      <form action="/admin/marketing" method="POST">
        <input type="hidden" name="provider" value="facebook_pixel"/>
        <div class="form-grid">
          <div class="form-group">
            <label>Pixel ID</label>
            <input type="text" name="tracking_id" value="<%= (fbConfig && fbConfig.tracking_id) ? fbConfig.tracking_id : '' %>" placeholder="Ex: 1234567890123456" style="font-family:'Share Tech Mono',monospace"/>
            <span class="form-hint">Encontre em Gerenciador de Eventos.</span>
          </div>
          <div class="form-group">
            <label>Status</label>
            <div class="toggle-wrap">
              <label class="toggle"><input type="checkbox" name="is_active" value="1" <%= (fbConfig && fbConfig.is_active) ? 'checked' : '' %>/><span class="toggle-track"></span></label>
              <span class="toggle-label">Ativar no site</span>
            </div>
          </div>
        </div>
        <% if(fbConfig && fbConfig.tracking_id){ %>
        <div class="code-block">
          <div class="code-label">// CODIGO INJETADO NO HEAD</div>
          <div class="code-text">fbq('init', '<span class="code-hl"><%= fbConfig.tracking_id %></span>');
fbq('track', 'PageView');</div>
        </div>
        <% } %>
        <div class="form-actions"><button type="submit" class="btn btn-primary"><svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>Salvar Facebook Pixel</button></div>
      </form>
    </div>

    <!-- GTM -->
    <div class="form-section">
      <div class="form-section-title">
        <span>Google Tag Manager</span>
        <span class="badge <%= (gtmConfig && gtmConfig.is_active && gtmConfig.tracking_id) ? 'badge-active' : 'badge-inactive' %>"><%= (gtmConfig && gtmConfig.is_active && gtmConfig.tracking_id) ? 'ATIVO' : 'INATIVO' %></span>
      </div>
      <form action="/admin/marketing" method="POST">
        <input type="hidden" name="provider" value="gtm"/>
        <div class="form-grid">
          <div class="form-group">
            <label>GTM ID</label>
            <input type="text" name="tracking_id" value="<%= (gtmConfig && gtmConfig.tracking_id) ? gtmConfig.tracking_id : '' %>" placeholder="Ex: GTM-XXXXXXX" style="font-family:'Share Tech Mono',monospace"/>
            <span class="form-hint">Formato: GTM-XXXXXXX</span>
          </div>
          <div class="form-group">
            <label>Status</label>
            <div class="toggle-wrap">
              <label class="toggle"><input type="checkbox" name="is_active" value="1" <%= (gtmConfig && gtmConfig.is_active) ? 'checked' : '' %>/><span class="toggle-track"></span></label>
              <span class="toggle-label">Ativar no site</span>
            </div>
          </div>
        </div>
        <div class="form-actions"><button type="submit" class="btn btn-primary"><svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>Salvar GTM</button></div>
      </form>
    </div>

    <!-- GA4 -->
    <div class="form-section">
      <div class="form-section-title">
        <span>Google Analytics 4</span>
        <span class="badge <%= (ga4Config && ga4Config.is_active && ga4Config.tracking_id) ? 'badge-active' : 'badge-inactive' %>"><%= (ga4Config && ga4Config.is_active && ga4Config.tracking_id) ? 'ATIVO' : 'INATIVO' %></span>
      </div>
      <form action="/admin/marketing" method="POST">
        <input type="hidden" name="provider" value="ga4"/>
        <div class="form-grid">
          <div class="form-group">
            <label>Measurement ID</label>
            <input type="text" name="tracking_id" value="<%= (ga4Config && ga4Config.tracking_id) ? ga4Config.tracking_id : '' %>" placeholder="Ex: G-XXXXXXXXXX" style="font-family:'Share Tech Mono',monospace"/>
            <span class="form-hint">Formato: G-XXXXXXXXXX</span>
          </div>
          <div class="form-group">
            <label>Status</label>
            <div class="toggle-wrap">
              <label class="toggle"><input type="checkbox" name="is_active" value="1" <%= (ga4Config && ga4Config.is_active) ? 'checked' : '' %>/><span class="toggle-track"></span></label>
              <span class="toggle-label">Ativar no site</span>
            </div>
          </div>
        </div>
        <div class="form-actions"><button type="submit" class="btn btn-primary"><svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>Salvar GA4</button></div>
      </form>
    </div>

    <% if(recentLogs && recentLogs.length > 0){ %>
    <div class="table-wrap">
      <div class="table-header"><div class="table-title">Historico de Alteracoes</div></div>
      <div style="overflow-x:auto">
        <table>
          <thead><tr><th>ACAO</th><th>USUARIO</th><th>DATA</th><th>IP</th></tr></thead>
          <tbody>
            <% recentLogs.forEach(function(l){ %>
            <tr>
              <td><span style="font-family:'Share Tech Mono',monospace;font-size:.7rem"><%= l.action %></span></td>
              <td style="font-size:.82rem"><%= l.user_name || '-' %></td>
              <td style="font-family:'Share Tech Mono',monospace;font-size:.65rem;color:var(--text-muted)"><%= new Date(l.created_at).toLocaleString('pt-BR') %></td>
              <td style="font-family:'Share Tech Mono',monospace;font-size:.65rem;color:var(--text-muted)"><%= l.ip_address || '-' %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

  </main>
</div>
</body>
</html>
