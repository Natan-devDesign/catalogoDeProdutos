<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %> · BRIWAX Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet"/>
<style>
/* ── TOKENS (idênticos ao site público) ── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --blue-deep:#071470;
  --blue-mid:#1135b8;
  --blue-bright:#2352e8;
  --blue-light:#3b82f6;
  --blue-glow:#60a5fa;
  --white:#ffffff;
  --off-white:#f0f5ff;
  --gray:#e8eef8;
  --text-dark:#0d1a5c;
  --text-muted:#5a6fa8;
  --border:rgba(255,255,255,.18);
  --border-blue:rgba(35,82,232,.18);
  /* Tokens exclusivos do dashboard */
  --sidebar-w:260px;
  --topbar-h:60px;
  --success:#16a34a;
  --danger:#dc2626;
  --warning:#d97706;
}

html,body{height:100%}
body{font-family:'Rajdhani',sans-serif;background:var(--off-white);color:var(--text-dark);display:flex;overflow-x:hidden}

/* ── SIDEBAR ───────────────────────────────────────────────── */
.sidebar{
  width:var(--sidebar-w);
  min-height:100vh;
  background:var(--blue-deep);
  display:flex;flex-direction:column;
  position:fixed;top:0;left:0;
  z-index:200;
  transition:transform .3s ease;
}
.sidebar-logo{
  font-family:'Bebas Neue',sans-serif;
  font-size:1.65rem;letter-spacing:.2em;
  color:var(--white);
  padding:1.4rem 1.5rem 1rem;
  border-bottom:1px solid rgba(255,255,255,.08);
  display:flex;align-items:center;gap:.6rem;
  text-decoration:none;
}
.sidebar-logo span{
  font-family:'Share Tech Mono',monospace;
  font-size:.5rem;letter-spacing:.25em;
  color:rgba(255,255,255,.35);
  display:block;margin-top:2px;
}
.sidebar-section{
  padding:.8rem 1.5rem .3rem;
  font-family:'Share Tech Mono',monospace;
  font-size:.55rem;letter-spacing:.28em;
  color:rgba(255,255,255,.25);
  text-transform:uppercase;
}
.sidebar-nav{flex:1;padding:.5rem 0;overflow-y:auto}
.nav-item{
  display:flex;align-items:center;gap:.75rem;
  padding:.78rem 1.5rem;
  font-weight:600;font-size:.76rem;letter-spacing:.14em;text-transform:uppercase;
  color:rgba(255,255,255,.6);
  text-decoration:none;
  border-left:3px solid transparent;
  transition:all .2s;
  cursor:pointer;
}
.nav-item svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.8;flex-shrink:0}
.nav-item:hover{color:rgba(255,255,255,.9);background:rgba(255,255,255,.05);border-left-color:rgba(255,255,255,.2)}
.nav-item.active{color:var(--white);background:rgba(35,82,232,.25);border-left-color:var(--blue-bright)}
.nav-item .badge{
  margin-left:auto;
  background:var(--blue-bright);
  color:var(--white);
  font-size:.55rem;letter-spacing:.1em;
  padding:2px 7px;border-radius:2px;
}

.sidebar-user{
  padding:1rem 1.5rem;
  border-top:1px solid rgba(255,255,255,.08);
  display:flex;align-items:center;gap:.75rem;
}
.user-avatar{
  width:34px;height:34px;border-radius:50%;
  background:var(--blue-bright);
  display:flex;align-items:center;justify-content:center;
  font-family:'Bebas Neue',sans-serif;font-size:1rem;
  color:var(--white);flex-shrink:0;
}
.user-info{flex:1;min-width:0}
.user-name{font-weight:700;font-size:.8rem;letter-spacing:.06em;color:var(--white);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.user-role{font-size:.65rem;color:rgba(255,255,255,.4);letter-spacing:.1em;text-transform:uppercase}
.logout-btn{
  color:rgba(255,255,255,.4);background:none;border:none;cursor:pointer;
  padding:4px;transition:color .2s;
}
.logout-btn:hover{color:rgba(255,255,255,.9)}
.logout-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8}

/* ── MAIN ──────────────────────────────────────────────────── */
.main-wrap{
  margin-left:var(--sidebar-w);
  flex:1;min-height:100vh;
  display:flex;flex-direction:column;
}

/* ── TOPBAR ────────────────────────────────────────────────── */
.topbar{
  height:var(--topbar-h);
  background:var(--white);
  border-bottom:1px solid var(--border-blue);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 2rem;
  position:sticky;top:0;z-index:100;
  box-shadow:0 1px 12px rgba(7,20,112,.06);
}
.topbar-left{display:flex;align-items:center;gap:1rem}
.burger-btn{
  display:none;background:none;border:none;cursor:pointer;padding:4px;
  color:var(--text-muted);
}
.burger-btn svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8}
.page-title{
  font-family:'Bebas Neue',sans-serif;
  font-size:1.3rem;letter-spacing:.1em;color:var(--text-dark);
}
.page-breadcrumb{
  font-family:'Share Tech Mono',monospace;
  font-size:.6rem;letter-spacing:.18em;color:var(--text-muted);
}
.topbar-right{display:flex;align-items:center;gap:1rem}
.topbar-btn{
  font-family:'Rajdhani',sans-serif;font-weight:700;
  font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;
  padding:.45rem 1.2rem;
  border:1.5px solid var(--border-blue);
  background:transparent;color:var(--text-muted);
  cursor:pointer;transition:all .22s;text-decoration:none;
  clip-path:polygon(5px 0%,100% 0%,100% calc(100% - 5px),calc(100% - 5px) 100%,0% 100%,0% 5px);
  display:inline-flex;align-items:center;gap:.4rem;
}
.topbar-btn:hover{border-color:var(--blue-bright);color:var(--blue-bright)}
.topbar-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}

/* View site link */
.site-link{color:var(--text-muted);font-size:.72rem;font-weight:600;letter-spacing:.1em;text-decoration:none;display:flex;align-items:center;gap:.3rem;transition:color .2s}
.site-link:hover{color:var(--blue-mid)}
.site-link svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2}

/* ── PAGE CONTENT ──────────────────────────────────────────── */
.page-content{flex:1;padding:2rem 2.5rem 3rem}

/* ── FLASH MESSAGES ────────────────────────────────────────── */
.flash{
  padding:.85rem 1.2rem;margin-bottom:1.5rem;
  font-weight:600;font-size:.85rem;letter-spacing:.06em;
  border-left:3px solid;display:flex;align-items:center;gap:.6rem;
}
.flash svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;flex-shrink:0}
.flash-success{background:rgba(22,163,74,.08);border-color:var(--success);color:var(--success)}
.flash-error{background:rgba(220,38,38,.08);border-color:var(--danger);color:var(--danger)}
.flash-warning{background:rgba(217,119,6,.08);border-color:var(--warning);color:var(--warning)}

/* ── STAT CARDS ────────────────────────────────────────────── */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:2rem}
.stat-card{
  background:var(--white);
  border:1px solid var(--border-blue);
  padding:1.4rem 1.5rem;
  display:flex;flex-direction:column;gap:.4rem;
  clip-path:polygon(8px 0%,100% 0%,100% calc(100% - 8px),calc(100% - 8px) 100%,0% 100%,0% 8px);
}
.stat-label{font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.22em;color:var(--text-muted);text-transform:uppercase}
.stat-value{font-family:'Bebas Neue',sans-serif;font-size:2.4rem;letter-spacing:.04em;color:var(--text-dark);line-height:1}
.stat-sub{font-size:.75rem;color:var(--text-muted);letter-spacing:.04em}
.stat-card.accent{border-color:var(--blue-mid);border-left:3px solid var(--blue-mid)}
.stat-card.accent .stat-value{color:var(--blue-mid)}

/* ── DATA TABLE ────────────────────────────────────────────── */
.table-wrap{background:var(--white);border:1px solid var(--border-blue);overflow:hidden}
.table-header{
  padding:1.1rem 1.5rem;
  border-bottom:1px solid var(--border-blue);
  display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;
}
.table-title{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;letter-spacing:.08em;color:var(--text-dark)}
.table-search{
  flex:1;max-width:280px;position:relative;
}
.table-search input{
  width:100%;font-family:'Rajdhani',sans-serif;font-size:.88rem;font-weight:500;
  background:var(--off-white);border:1.5px solid var(--border-blue);
  color:var(--text-dark);padding:.55rem .9rem .55rem 2.4rem;
  outline:none;transition:border-color .25s;
}
.table-search input:focus{border-color:var(--blue-bright)}
.table-search svg{position:absolute;left:.7rem;top:50%;transform:translateY(-50%);width:14px;height:14px;stroke:var(--text-muted);fill:none;stroke-width:2}
table{width:100%;border-collapse:collapse}
thead{background:var(--off-white);border-bottom:1px solid var(--border-blue)}
thead th{
  font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.2em;
  color:var(--text-muted);padding:.8rem 1.2rem;text-align:left;
  white-space:nowrap;
}
tbody tr{border-bottom:1px solid rgba(35,82,232,.07);transition:background .15s}
tbody tr:last-child{border-bottom:none}
tbody tr:hover{background:rgba(35,82,232,.03)}
tbody td{padding:.85rem 1.2rem;font-size:.88rem;color:var(--text-dark);vertical-align:middle}
.td-sku{font-family:'Share Tech Mono',monospace;font-size:.72rem;color:var(--text-muted)}
.td-actions{display:flex;align-items:center;gap:.4rem;justify-content:flex-end}

/* Status badges */
.badge{
  font-family:'Share Tech Mono',monospace;font-size:.58rem;letter-spacing:.15em;
  padding:3px 9px;display:inline-flex;align-items:center;gap:4px;
}
.badge-active{background:rgba(22,163,74,.1);color:var(--success)}
.badge-inactive{background:rgba(107,114,128,.1);color:var(--text-muted)}
.badge-admin{background:rgba(35,82,232,.12);color:var(--blue-mid)}
.badge-editor{background:rgba(217,119,6,.1);color:var(--warning)}

/* ── ACTION BUTTONS ────────────────────────────────────────── */
.btn{
  font-family:'Rajdhani',sans-serif;font-weight:700;
  font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;
  padding:.5rem 1.3rem;cursor:pointer;transition:all .22s;
  display:inline-flex;align-items:center;gap:.4rem;text-decoration:none;
  border:1.5px solid;
  clip-path:polygon(5px 0%,100% 0%,100% calc(100% - 5px),calc(100% - 5px) 100%,0% 100%,0% 5px);
}
.btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}
.btn-primary{background:var(--blue-mid);border-color:var(--blue-mid);color:var(--white)}
.btn-primary:hover{background:var(--blue-bright);border-color:var(--blue-bright)}
.btn-outline{background:transparent;border-color:var(--border-blue);color:var(--text-muted)}
.btn-outline:hover{border-color:var(--blue-bright);color:var(--blue-bright)}
.btn-danger{background:transparent;border-color:rgba(220,38,38,.3);color:var(--danger)}
.btn-danger:hover{background:rgba(220,38,38,.08)}
.btn-icon{
  width:32px;height:32px;padding:0;display:inline-flex;align-items:center;justify-content:center;
  background:transparent;border:1.5px solid var(--border-blue);color:var(--text-muted);
  cursor:pointer;transition:all .2s;clip-path:none;font-size:0;
}
.btn-icon svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}
.btn-icon:hover{border-color:var(--blue-bright);color:var(--blue-bright)}
.btn-icon.danger:hover{border-color:var(--danger);color:var(--danger)}

/* ── FORMS ─────────────────────────────────────────────────── */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
.form-grid.cols-3{grid-template-columns:1fr 1fr 1fr}
.form-grid.full{grid-template-columns:1fr}
.form-group{display:flex;flex-direction:column;gap:.4rem}
.form-group.span2{grid-column:span 2}
.form-group.span3{grid-column:1/-1}
label{font-family:'Share Tech Mono',monospace;font-size:.6rem;letter-spacing:.2em;color:var(--text-muted);text-transform:uppercase}
label .req{color:var(--blue-bright)}
input[type=text],input[type=email],input[type=password],input[type=number],input[type=url],select,textarea{
  font-family:'Rajdhani',sans-serif;font-size:.92rem;font-weight:500;letter-spacing:.04em;
  background:var(--off-white);border:1.5px solid var(--border-blue);
  color:var(--text-dark);padding:.65rem .9rem;
  outline:none;transition:border-color .25s,box-shadow .25s;width:100%;
  clip-path:polygon(5px 0%,100% 0%,100% calc(100% - 5px),calc(100% - 5px) 100%,0% 100%,0% 5px);
}
input:focus,select:focus,textarea:focus{
  border-color:var(--blue-bright);
  box-shadow:0 0 0 3px rgba(35,82,232,.1);
}
textarea{resize:vertical;min-height:100px}
.form-hint{font-size:.72rem;color:var(--text-muted);letter-spacing:.04em}
.form-error{font-size:.72rem;color:var(--danger)}
.form-section{
  padding:1.4rem 1.5rem;
  background:var(--white);
  border:1px solid var(--border-blue);
  margin-bottom:1.2rem;
}
.form-section-title{
  font-family:'Bebas Neue',sans-serif;font-size:1rem;letter-spacing:.1em;
  color:var(--text-dark);margin-bottom:1rem;padding-bottom:.6rem;
  border-bottom:1px solid var(--border-blue);
}
.form-actions{
  display:flex;align-items:center;justify-content:space-between;
  padding-top:1rem;margin-top:.5rem;
  border-top:1px solid var(--border-blue);
  flex-wrap:wrap;gap:.75rem;
}

/* ── IMAGE UPLOAD ZONE ─────────────────────────────────────── */
.upload-zone{
  border:2px dashed var(--border-blue);
  padding:2rem;text-align:center;
  transition:border-color .25s,background .25s;
  cursor:pointer;
  background:var(--off-white);
}
.upload-zone:hover,.upload-zone.drag-over{border-color:var(--blue-bright);background:rgba(35,82,232,.04)}
.upload-zone svg{width:32px;height:32px;stroke:var(--text-muted);fill:none;stroke-width:1.5;margin-bottom:.6rem}
.upload-zone p{font-size:.82rem;color:var(--text-muted);letter-spacing:.06em}
.upload-zone strong{color:var(--blue-mid)}
.image-preview-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:.6rem;margin-top:1rem}
.image-thumb{
  position:relative;aspect-ratio:1;overflow:hidden;
  border:1.5px solid var(--border-blue);background:var(--off-white);
}
.image-thumb img{width:100%;height:100%;object-fit:cover}
.image-thumb .remove-img{
  position:absolute;top:3px;right:3px;
  width:20px;height:20px;border-radius:50%;
  background:rgba(220,38,38,.85);color:var(--white);
  border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:12px;
}
.image-thumb .cover-badge{
  position:absolute;bottom:3px;left:3px;
  background:var(--blue-mid);color:var(--white);
  font-family:'Share Tech Mono',monospace;font-size:.45rem;letter-spacing:.1em;
  padding:2px 5px;
}

/* ── MODAL ─────────────────────────────────────────────────── */
.modal-overlay{
  position:fixed;inset:0;background:rgba(7,20,112,.6);
  display:none;align-items:center;justify-content:center;
  z-index:500;backdrop-filter:blur(4px);padding:1rem;
}
.modal-overlay.open{display:flex}
.modal{
  background:var(--white);width:min(680px,100%);
  max-height:85vh;display:flex;flex-direction:column;
  animation:modalIn .3s cubic-bezier(.16,1,.3,1) both;
}
@keyframes modalIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.modal-header{
  padding:1.2rem 1.5rem;
  border-bottom:1px solid var(--border-blue);
  display:flex;align-items:center;justify-content:space-between;
  flex-shrink:0;
}
.modal-title{font-family:'Bebas Neue',sans-serif;font-size:1.2rem;letter-spacing:.1em;color:var(--text-dark)}
.modal-close{background:none;border:none;cursor:pointer;color:var(--text-muted);padding:4px;transition:color .2s}
.modal-close:hover{color:var(--text-dark)}
.modal-close svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2}
.modal-body{flex:1;overflow-y:auto;padding:1.2rem 1.5rem}
.modal-footer{
  padding:1rem 1.5rem;
  border-top:1px solid var(--border-blue);
  display:flex;align-items:center;justify-content:flex-end;gap:.75rem;
  flex-shrink:0;
}

/* ── TOGGLE SWITCH ─────────────────────────────────────────── */
.toggle-wrap{display:flex;align-items:center;gap:.75rem}
.toggle{position:relative;width:42px;height:24px;flex-shrink:0}
.toggle input{opacity:0;width:0;height:0}
.toggle-track{
  position:absolute;inset:0;border-radius:12px;
  background:var(--gray);transition:background .25s;cursor:pointer;
}
.toggle input:checked + .toggle-track{background:var(--blue-mid)}
.toggle-track::after{
  content:'';position:absolute;
  left:3px;top:3px;
  width:18px;height:18px;border-radius:50%;
  background:var(--white);transition:transform .25s;
  box-shadow:0 1px 4px rgba(0,0,0,.2);
}
.toggle input:checked + .toggle-track::after{transform:translateX(18px)}
.toggle-label{font-weight:600;font-size:.82rem;color:var(--text-dark)}

/* ── PAGINATION ────────────────────────────────────────────── */
.pagination{display:flex;align-items:center;gap:.4rem;margin-top:1.2rem;justify-content:center}
.page-btn{
  font-family:'Share Tech Mono',monospace;font-size:.65rem;letter-spacing:.1em;
  padding:.4rem .8rem;border:1.5px solid var(--border-blue);
  background:transparent;color:var(--text-muted);cursor:pointer;transition:all .2s;
}
.page-btn:hover,.page-btn.active{border-color:var(--blue-mid);color:var(--blue-mid);background:rgba(17,53,184,.06)}
.page-btn:disabled{opacity:.4;cursor:not-allowed}

/* ── RESPONSIVE ────────────────────────────────────────────── */
@media(max-width:900px){
  .sidebar{transform:translateX(-100%)}
  .sidebar.open{transform:translateX(0)}
  .main-wrap{margin-left:0}
  .burger-btn{display:flex}
  .page-content{padding:1.2rem 1rem 2rem}
  .form-grid{grid-template-columns:1fr}
  .form-group.span2{grid-column:span 1}
  .stats-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:480px){
  .stats-grid{grid-template-columns:1fr}
  .table-header{flex-direction:column;align-items:flex-start}
  .table-search{max-width:100%}
}
</style>
</head>
<body>

<!-- ── SIDEBAR ─────────────────────────────────────────────── -->
<aside class="sidebar" id="sidebar">
  <a href="/admin" class="sidebar-logo">
    BRIWAX
    <span>// PAINEL ADMIN</span>
  </a>

  <nav class="sidebar-nav">
    <div class="sidebar-section">Principal</div>
    <a href="/admin" class="nav-item <%= currentPage === 'dashboard' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Dashboard
    </a>

    <div class="sidebar-section">Catálogo</div>
    <a href="/admin/produtos" class="nav-item <%= currentPage === 'products' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v10a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
      Produtos
    </a>
    <a href="/admin/produtos/novo" class="nav-item <%= currentPage === 'product-new' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      Adicionar Produto
    </a>

    <div class="sidebar-section">Site</div>
    <a href="/admin/home-editor" class="nav-item <%= currentPage === 'home-editor' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      Editor da Home
    </a>

    <% if (user.role === 'admin') { %>
    <div class="sidebar-section">Marketing & Config</div>
    <a href="/admin/marketing" class="nav-item <%= currentPage === 'marketing' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
      Marketing & Analytics
    </a>
    <a href="/admin/usuarios" class="nav-item <%= currentPage === 'users' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
      Usuários
    </a>
    <% } %>
  <div class="sidebar-section">Conta</div>
    <a href="/admin/minha-conta" class="nav-item <%= currentPage === 'account' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      Minha Conta
    </a>
  </nav>

  <div class="sidebar-user">
    <div class="user-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
    <div class="user-info">
      <div class="user-name"><%= user.name %></div>
      <div class="user-role"><%= user.role %></div>
    </div>
    <form action="/auth/logout" method="POST" style="margin:0">
      <button type="submit" class="logout-btn" title="Sair">
        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      </button>
    </form>
  </div>
</aside>

<!-- ── MAIN ─────────────────────────────────────────────────── -->
<div class="main-wrap">
  <!-- TOPBAR -->
  <header class="topbar">
    <div class="topbar-left">
      <button class="burger-btn" id="burgerBtn">
        <svg viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div>
        <div class="page-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></div>
        <% if (typeof breadcrumb !== 'undefined') { %>
        <div class="page-breadcrumb"><%= breadcrumb %></div>
        <% } %>
      </div>
    </div>
    <div class="topbar-right">
      <a href="/" target="_blank" class="site-link">
        <svg viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Ver Site
      </a>
    </div>
  </header>

  <!-- PAGE CONTENT -->
  <main class="page-content">
    <!-- Flash messages -->
    <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="flash flash-<%= flash.type %>">
      <% if (flash.type === 'success') { %>
        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
      <% } else { %>
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <% } %>
      <%= flash.message %>
    </div>
    <% } %>

    <%- body %>
  </main>
</div>

<script>
const burger = document.getElementById('burgerBtn');
const sidebar = document.getElementById('sidebar');
burger?.addEventListener('click', () => sidebar.classList.toggle('open'));
document.addEventListener('click', e => {
  if (window.innerWidth <= 900 && !sidebar.contains(e.target) && !burger.contains(e.target)) {
    sidebar.classList.remove('open');
  }
});
</script>
<%- typeof extraJs !== 'undefined' ? extraJs : '' %>
</body>
</html>
