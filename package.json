{
  "name": "briwax",
  "version": "1.0.0",
  "description": "Briwax — Sistema Web Dinâmico com Dashboard Administrativo",
  "main": "server.js",
  "scripts": {
    "start":      "node server.js",
    "dev":        "nodemon server.js",
    "db:schema":  "psql $DATABASE_URL -f database/schema.sql",
    "db:seed":    "psql $DATABASE_URL -f database/seed.sql",
    "db:reset":   "psql $DATABASE_URL -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run db:schema && npm run db:seed",
    "hash":       "node -e \"const b=require('bcrypt');const p=process.argv[1];b.hash(p,12).then(console.log)\" --"
  },
  "dependencies": {
    "bcrypt":             "^5.1.1",
    "cookie-parser":      "^1.4.6",
    "dotenv":             "^16.4.5",
    "ejs":                "^3.1.10",
    "express":            "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet":             "^7.1.0",
    "jsonwebtoken":       "^9.0.2",
    "multer":             "^1.4.5-lts.1",
    "pg":                 "^8.12.0",
    "slugify":            "^1.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
